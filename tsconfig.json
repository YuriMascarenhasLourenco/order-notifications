{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "event-lib/events": [
        "libs/events/src"
      ],
      "event-lib/events/*": [
        "libs/events/src/*"
      ],
      "lib/my-library": [
        "libs/my-library/src"
      ],
      "lib/my-library/*": [
        "libs/my-library/src/*"
      ],
      "rabbitmq/rabbitmq": [
        "libs/rabbitmq/src"
      ],
      "rabbitmq/rabbitmq/*": [
        "libs/rabbitmq/src/*"
      ]
    }
  }
}